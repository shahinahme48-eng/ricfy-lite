{
  box-sizing:border-box;
  font-family:Arial, Helvetica, sans-serif;
}

body{
  margin:0;
  background:#020617;
  color:white;
  text-align:center;
}

header{
  padding:10px;
  border-bottom:1px solid #1e293b;
}

.controls{
  padding:10px;
}

.controls input{
  padding:6px;
  margin:4px;
  width:120px;
}

.controls button{
  padding:6px 10px;
  margin:4px;
  cursor:pointer;
}

#board{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:6px;
  padding:10px;
  min-height:60px;
}

.tile{
  background:#f8fafc;
  color:black;
  padding:8px 10px;
  border-radius:6px;
  font-weight:bold;
  cursor:pointer;
}

.players{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  padding:10px;
}

.hand{
  min-height:50px;
  border:1px dashed #334155;
  padding:6px;
}

#drawBtn{
  width:90%;
  margin:10px auto;
  padding:10px;
  font-size:16px;
  background:#22c55e;
  border:none;
  border-radius:10px;
  cursor:pointer;
}

#chatBox{
  max-height:120px;
  overflow-y:auto;
  border:1px solid #38bdf8;
  margin:6px;
  padding:6px;
  text-align:left;
  font-size:14px;
}

#chatInput{
  width:70%;
  padding:6px;
}
