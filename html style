body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #020617;
  color: white;
  text-align: center;
}

header {
  padding: 10px;
  border-bottom: 1px solid #1e293b;
}

.controls input, #chatInput {
  padding: 6px;
  margin: 4px;
}

.controls button, #chatBtn {
  padding: 6px 10px;
  margin: 4px;
  cursor: pointer;
}

#board {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 10px;
}

.players {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  padding: 10px;
}

.hand { min-height: 60px; }

.tile {
  background: #f8fafc;
  color: black;
  padding: 8px;
  border-radius: 6px;
  display: inline-block;
  margin: 4px;
  cursor: pointer;
  font-weight: bold;
}

#drawBtn {
  width: 90%;
  margin: 10px;
  padding: 10px;
  background: #22c55e;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  cursor: pointer;
}

#chatBox {
  max-height: 120px;
  overflow-y: auto;
  border: 1px solid #38bdf8;
  margin: 5px;
  padding: 5px;
}
