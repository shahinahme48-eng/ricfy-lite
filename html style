body {
  font-family: Arial;
  text-align: center;
  background: #0f172a;
  color: white;
}

.hand, #board {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin: 10px;
  flex-wrap: wrap;
}

.tile {
  background: white;
  color: black;
  padding: 10px;
  border-radius: 6px;
  cursor: pointer;
  min-width: 40px;
}

.tile:hover {
  background: #38bdf8;
}
