body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: white;
  text-align: center;
}

h1 {
  margin-top: 15px;
}

#status {
  margin: 10px;
  font-size: 18px;
  color: #38bdf8;
}

#board, .hand {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin: 15px;
  flex-wrap: wrap;
}

.tile {
  background: #f8fafc;
  color: black;
  border-radius: 8px;
  padding: 8px;
  min-width: 45px;
  min-height: 65px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  cursor: pointer;
}

.tile:hover {
  background: #38bdf8;
}

.vertical {
  flex-direction: column;
}

.horizontal {
  flex-direction: row;
}

.divider {
  width: 100%;
  height: 2px;
  background: black;
  margin: 4px 0;
}

#drawBtn {
  padding: 10px 20px;
  font-size: 16px;
  background: #22c55e;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

#drawBtn:hover {
  background: #16a34a;
}
